manifest {
    name            = 'ViRAE'
    author          = 'Konstantinos Konstantinidis'
    homePage        = 'https://github.com/konskons11/ViRAE'
    description     = 'Context-based trimming tool for virus genome RNA-seq read decontamination'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.1'
}

// Default process configuration
process {
    cpus   = { Runtime.runtime.availableProcessors() }
    memory = 8.GB
    shell  = ['/bin/bash', '-euo', 'pipefail']
}

// Execution Profiles
profiles {
    // 1. Recommended if you already have bwa and samtools installed locally in your PATH
    local {
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
    }

    // 2. Conda profile: Uses mamba for fast resolution
    conda {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        process.conda          = 'bioconda::bwa=0.7.17 bioconda::samtools=1.13 conda-forge::bc'
    }

    // 3. Docker container (Linux & macOS Docker Desktop)
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        conda.enabled          = false
        process.container      = 'quay.io/biocontainers/mulled-v2-ad317d07f80c3c0f479aa53a61a65900595ecbe4:6702e84ab4b60946765796a9c1e74f1c9c0fb925-0'
    }

    // 4. Singularity container (HPC Clusters)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
        process.container      = 'https://depot.galaxyproject.org/singularity/mulled-v2-ad317d07f80c3c0f479aa53a61a65900595ecbe4:6702e84ab4b60946765796a9c1e74f1c9c0fb925-0'
    }
}
