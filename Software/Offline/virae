// --- Helper Functions ---
def getParam(List<String> keys, defaultValue = null) {
    def foundKey = keys.find { key -> params.containsKey(key) && params[key] != null && params[key] != '' }
    return foundKey ? params[foundKey] : defaultValue
}

def getExt(path) {
    def p = path.toString()
    return p.substring(p.lastIndexOf('.') + 1).toLowerCase()
}

def stripExt(path, ext) {
    def f = file(path).getName()
    def suffix = "." + ext
    if (f.toLowerCase().endsWith(suffix.toLowerCase())) {
        return f.substring(0, f.length() - suffix.length())
    }
    return f
}

def commonPrefix(String s1, String s2) {
    int maxLen = Math.min(s1.length(), s2.length())
    if (maxLen == 0) return ""
    def mismatch = (0..<maxLen).find { i -> s1.charAt(i) != s2.charAt(i) }
    return mismatch != null ? s1.substring(0, mismatch as Integer) : s1.substring(0, maxLen)
}

